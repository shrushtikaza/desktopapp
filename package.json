{
  "name": "happy_anniversary",
  "version": "1.0.0",
  "productName": "happy anniversary",
  "main": "main.js",
  "description": "thanks for the best year",
  "author": "shrushti",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "productName": "happy anniversary",
    "appId": "com.yourdomain.happyanniversary",
    "files": [
      "dist/**/*",
      "songs/**/*",
      "images/**/*",
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "songs",
        "to": "songs"
      },
      {
        "from": "images",
        "to": "images"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^24.13.3"
  }
}
